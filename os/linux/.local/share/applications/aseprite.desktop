[Desktop Entry]
# Tracked 2026-10-08: was a hand-made file on littleplow only, so bigplow had
# Aseprite installed (bin/aseprite-build) but nothing in the app menu.
Type=Application
Name=Aseprite
Comment=Animated sprite editor & pixel art tool
Exec=/home/dev/Apps/aseprite/bin/aseprite %F
Icon=aseprite
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/x-aseprite;
StartupNotify=true
