#!/usr/bin/env bash
# Forces a command to render via the NVIDIA GPU's DRM render node instead of
# whatever is driving the (currently broken/stub) display path. See
# nobara-nvidia-fix session notes: nvidia-drm.modeset=0 leaves no real primary
# display device, but /dev/dri/renderD128 (nvidia) still works for rendering.
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
exec "$@"
