#!/usr/bin/env bash
# doctor — one-shot health check for this machine (the public half). Prints ✓/✗ for
# every layer so you never have to read the docs to answer "is this set up right?":
#   runtimes · CLI tools (user-level) · GUI apps (flatpak) · desktop wiring.
#   Green = done. Red = the exact thing to fix.
#
#   just doctor            (or: bash ~/Repos/dotfiles/bin/doctor)
#
# Read-only. Never installs, never sudo's, never mutates. Safe to run any time.
set -uo pipefail

# bootstrap.sh installs mise/etc to ~/.local/bin + mise shims; a non-login
# shell won't have them on PATH, so add them before probing (else false ✗).
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.bun/bin:$PATH"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PKGFILE="$REPO/packages.yaml"
PASS=0 FAILN=0
declare -a TOFIX=()

c_g=$'\033[1;32m'
c_r=$'\033[1;31m'
c_y=$'\033[1;33m'
c_b=$'\033[1;34m'
c_0=$'\033[0m'
head() { printf '\n%s── %s%s\n' "$c_b" "$*" "$c_0"; }
ok() {
  printf '  %s✓%s %s\n' "$c_g" "$c_0" "$*"
  PASS=$((PASS + 1))
}
no() {
  printf '  %s✗%s %s\n' "$c_r" "$c_0" "$*"
  FAILN=$((FAILN + 1))
  TOFIX+=("$*")
}
note() { printf '  %s•%s %s\n' "$c_y" "$c_0" "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

# yq (mikefarah) — same one install-packages uses; needed to read packages.yaml
YQ=yq
have yq || { [ -x "$HOME/.local/bin/yq" ] && YQ="$HOME/.local/bin/yq"; }

# ── OS / location ───────────────────────────────────────────────────────────
head "Environment"
case "$(uname -s)" in
Linux) ok "host: Linux ($(
  . /etc/os-release 2>/dev/null
  echo "${PRETTY_NAME:-linux}"
))" ;;
Darwin)
  ok "host: macOS — locks/desktop checks skipped (Nobara-only)"
  MAC=1
  ;;
esac

# ── runtimes ────────────────────────────────────────────────────────────────
# What matters is that the runtime RESOLVES, not that mise is what provided it —
# the rule the CLI-tools section below already applies. This used to ask mise
# alone, so a mac running every runtime from brew failed all six checks while
# all six worked. Six standing false alarms is how a health check stops being read.
#
# mise still matters where a repo pins versions in .tool-versions, since brew
# gives one global version per machine. So a runtime that resolves from
# somewhere else is fine on mac and a note on linux, where mise is the path.
head "Runtimes"
for rt in node go python rust erlang elixir; do
  # A runtime's binary is rarely named after it: erlang is erl, elixir is iex,
  # rust is cargo, python is python3. The CLI-tools section hit the same thing
  # with ripgrep. Checking `have $rt` reports a working runtime as missing.
  case "$rt" in
    erlang) bin=erl ;; elixir) bin=iex ;; rust) bin=cargo ;; python) bin=python3 ;; *) bin=$rt ;;
  esac
  if have mise && mise ls --installed 2>/dev/null | grep -qiw "$rt"; then
    ok "$rt (mise)"
  elif have "$bin"; then
    if [ "${MAC:-0}" = 1 ]; then ok "$rt ($(command -v "$bin"))"
    else note "$rt resolves from $(command -v "$bin"), not mise — .tool-versions will not apply"; fi
  else
    no "runtime '$rt' not found — mise install"
  fi
done
have mise || note "mise not on PATH — needed for .tool-versions pinning (bootstrap.sh installs it)"

# ── user-level binaries that commonly break (dropped to ~/.local/bin, not dnf) ──
head "User binaries (~/.local/bin, PATH)"
for b in just claude bun herdr gitmux yq; do
  if have "$b"; then ok "$b"; else no "$b not on PATH"; fi
done
# Godot is an official godotengine.org build dropped to ~/.local/bin, not a flatpak,
# so the flatpak loop below cannot see it. `godot-runner` (a Nobara dependency) is a
# runtime for PLAYING Godot games, not the editor — do not accept it as this check.
if have godot; then
  ok "godot (official build, ~/.local/bin)"
else no "godot not on PATH — just provision (official build, not the flatpak)"; fi

# ── Neovim: the extras list is the tracked one ──────────────────────────────
# lazyvim.json is app-managed state and .gitignore skips it, so an extra added
# through the :LazyExtras UI lands ONLY there. It still loads, and it can
# override tracked config — ui.dashboard-nvim sets snacks dashboard.enabled =
# false, which killed a skin in my-overrides.lua with no error anywhere. The UI
# gives no warning and the extra never reaches another machine. Compare the two.
head "Neovim extras"
nvim_json="$HOME/.config/nvim/lazyvim.json"
nvim_lua="$HOME/.config/nvim/lua/config/lazy.lua"
if [ ! -f "$nvim_json" ]; then
  note "no lazyvim.json — nothing has been toggled in the :LazyExtras UI"
elif ! have python3; then
  note "python3 missing — cannot compare the extras lists"
else
  drift=$(python3 - "$nvim_json" "$nvim_lua" <<'PYEOF'
import json, re, sys
js = set(json.load(open(sys.argv[1])).get("extras", []))
lua = set(re.findall(r'import\s*=\s*"(lazyvim\.plugins\.extras\.[^"]+)"', open(sys.argv[2]).read()))
print(" ".join(sorted(js - lua)))
PYEOF
)
  if [ -z "$drift" ]; then
    ok "lazyvim.json adds no extra beyond lua/config/lazy.lua"
  else
    for e in $drift; do
      no "extra '$e' is in lazyvim.json but NOT lua/config/lazy.lua — add it there, or turn it off in :LazyExtras"
    done
  fi
fi

[ "${MAC:-0}" = 1 ] && {
  printf '\n'
  exit 0
}

# ── CLI tools (mise / uv — user-level, no admin) ────────────────────────────
head "CLI tools (user-level)"
if ! have mise; then
  no "mise not on PATH — run: just install"
else
  # What matters is that the tool RESOLVES, not that mise is what provided it:
  # Nobara ships some of these in its base (ripgrep, fd), and a host rpm is a
  # perfectly good source.
  #
  # The list is mise's own config (home/.config/mise/config.toml [tools]), the
  # single source since 2026-10-03 — packages.yaml no longer carries a mise: key.
  # Runtimes are checked above and skipped here; their binaries are not named
  # after the tool (erlang→erl, elixir→iex). ripgrep is the one tool whose binary
  # differs from its name.
  MISE_CFG="$HOME/.config/mise/config.toml"
  mapfile -t MISE < <(sed -n '/^\[tools\]/,/^\[/p' "$MISE_CFG" 2>/dev/null \
    | grep -oE '^[a-z][a-z0-9_-]* *=' | tr -d ' =' \
    | grep -vxE 'node|go|python|rust|erlang|elixir' | sed 's/^ripgrep$/rg/')
  miss=()
  for t in "${MISE[@]}"; do command -v "$t" >/dev/null 2>&1 || miss+=("$t"); done
  if [ "${#miss[@]}" -eq 0 ]; then
    ok "all ${#MISE[@]} user-level tools resolve"
  else no "tool(s) missing: ${miss[*]} — run: just install"; fi
fi

# ── packages with no user-level source (need the admin password) ────────────
# These are NOT installable by the owner. doctor only reports them; the fix is a
# single batched pkexec line so the admin is asked once, never once per package.
head "Admin-only packages"
# name<TAB>dnf<TAB>bin<TAB>pc — same probe order install-packages uses, so the two
# agree. A `pc:` hit, a `bin:` hit, or the NAME itself on PATH means the need is
# met by SOMETHING (a mise install or a binary drop like clangd counts); only
# then fall back to asking rpm. The name probe matters since 2026-10-03: tmux,
# glow, eza and friends come from mise and have only a dnf: key here, so without
# it doctor asked the admin to dnf-install seven tools already on PATH.
mapfile -t DNFROWS < <("$YQ" -r '.packages[] | select(.dnf != null and .uv == null) | [.name, .dnf, .bin // "null", .pc // "null"] | @tsv' "$PKGFILE" 2>/dev/null)
DNF=()
for row in "${DNFROWS[@]}"; do DNF+=("$(cut -f2 <<<"$row")"); done
if [ "${#DNF[@]}" -eq 0 ]; then
  ok "none declared"
else
  # --whatprovides, not plain rpm -q: Fedora renames packages (wget→wget2-wget,
  # SDL2-devel→sdl2-compat-devel) but the new one Provides the old name. An
  # installed package also provides its own name, so this covers both cases.
  missing=()
  for row in "${DNFROWS[@]}"; do
    IFS=$'\t' read -r rname rdnf rbin rpc <<<"$row"
    if [ "$rpc" != "null" ] && pkg-config --exists "$rpc" 2>/dev/null; then
      continue
    elif [ "$rbin" != "null" ] && command -v "$rbin" >/dev/null 2>&1; then
      continue
    elif command -v "$rname" >/dev/null 2>&1; then
      continue
    elif rpm -q --whatprovides "$rdnf" &>/dev/null; then
      continue
    fi
    missing+=("$rdnf")
  done
  if [ "${#missing[@]}" -eq 0 ]; then
    ok "all ${#DNF[@]} admin packages present on host"
  else
    # No -y. On 2026-10-02 a `dnf install -y` of one package dragged 43 Qt
    # packages forward and black-screened Plasma for two hours. The admin reads
    # the transaction summary before answering.
    no "${#missing[@]} missing — one prompt fixes all: pkexec dnf install ${missing[*]}"
  fi
fi

# ── GUI apps (flatpak --user) ───────────────────────────────────────────────
head "GUI apps (flatpak --user)"
if have flatpak; then
  installed="$(flatpak list --app --columns=application 2>/dev/null)"
  mapfile -t FP < <("$YQ" -r '.packages[] | select(.flatpak) | .flatpak' "$PKGFILE" 2>/dev/null)
  for id in "${FP[@]}"; do
    if grep -qxF "$id" <<<"$installed"; then ok "$id"; else no "$id not installed — just install"; fi
  done
  [ "${#FP[@]}" -eq 0 ] && note "no flatpak entries in packages.yaml"
else
  no "flatpak not on host — ask admin: sudo dnf install flatpak"
fi

# Two of the five live in root-only files (/boot/grub2, /etc/polkit-1/rules.d) the
# DAILY user can't read — so a plain "missing" would be a false alarm. Those checks
# are authoritative only as root (sudo just doctor); as the daily user they degrade
# to a note pointing at the step-12 self-test, which is the real behavioral gate.
head "Desktop (Plasma)"
[ -f /usr/share/wayland-sessions/plasma.desktop ] &&
  ok "Plasma session present at the greeter" ||
  no "no plasma.desktop in /usr/share/wayland-sessions — nothing to log into"

# Virtual desktops are runtime objects, not config: Desktops/Number in kwinrc is
# written BY KWin, it is not read as a request. Ten is what the keymap assumes.
VD=$(kreadconfig6 --file kwinrc --group Desktops --key Number 2>/dev/null || echo 0)
[ "${VD:-0}" -ge 10 ] && ok "$VD virtual desktops" ||
  no "only ${VD:-0} virtual desktops (keymap assumes 10) — run: just desktop"

# Ten desktops with no pager is ten desktops you cannot see. Meta+<digit> still
# switches, but nothing on screen says which one you landed on, so the whole
# keymap turns into a guess. Checked separately from the desktop count because
# the two are set up by different mechanisms and either can be missing alone:
# the desktops come from D-Bus calls to KWin, the pager is a panel widget.
APPLETS="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
if grep -q '^plugin=org.kde.plasma.pager$' "$APPLETS" 2>/dev/null; then
  ok "desktop pager in the panel (all $VD desktops visible)"
else
  no "no pager widget — $VD desktops with nothing showing which one you are on: just desktop"
fi

# Both KWin scripts must be installed AND enabled; installed-but-disabled is
# silent, and enabled-but-missing is equally silent.
for pair in "krohnkite:auto-tiling" "move-to-desktop:Meta+Ctrl+<digit> window moves"; do
  sc="${pair%%:*}"
  what="${pair#*:}"
  if [ -d "$HOME/.local/share/kwin/scripts/$sc" ]; then
    [ "$(kreadconfig6 --file kwinrc --group Plugins --key "${sc}Enabled" 2>/dev/null)" = "true" ] &&
      ok "$sc installed and enabled ($what)" ||
      no "$sc installed but NOT enabled — $what is dead. Run: just desktop"
  else
    no "$sc missing — $what is dead. Run: just desktop"
  fi
done

# THE TRAP THIS CHECK EXISTS FOR: a [services][x] _launch entry in
# kglobalshortcutsrc only RECORDS a launch shortcut. It shows up in System
# Settings and kglobalaccel reports it live with the right keycode, but the key
# is never grabbed. Worse, it counts as the component's first registration, so
# it permanently shadows the X-KDE-Shortcuts line in the desktop file that WOULD
# grab. Finding this cost a full session; a stale entry is invisible otherwise.
ACCEL="$HOME/.local/share/kglobalaccel"
if [ -d "$ACCEL" ] && ls "$ACCEL"/*.desktop >/dev/null 2>&1; then
  ok "$(ls "$ACCEL"/*.desktop | wc -l) launcher desktop files in ~/.local/share/kglobalaccel"
  shadowed=""
  for f in "$ACCEL"/*.desktop; do
    b=$(basename "$f")
    grep -q "^\[services\]\[$b\]" "$HOME/.config/kglobalshortcutsrc" 2>/dev/null && shadowed="$shadowed $b"
  done
  [ -z "$shadowed" ] && ok "no stale [services] _launch entries shadowing them" ||
    no "stale kglobalshortcutsrc [services] entries SHADOW these launchers:$shadowed — the keys will not fire. Run: just desktop"
else
  no "no launcher desktop files in ~/.local/share/kglobalaccel — app shortcuts dead. Run: just desktop"
fi

# Outputs must not overlap. KWin once placed HDMI-A-1 inside eDP-1's span and
# windows visibly bled between screens; nothing else reports that as wrong.
if have kscreen-doctor; then
  overlap=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '
    /Geometry:/ { gsub(/,/, " "); n++; x[n]=$2; y[n]=$3; split($4,d,"x"); w[n]=d[1]; h[n]=d[2] }
    END { for (i=1;i<n;i++) for (j=i+1;j<=n;j++)
            if (x[i] < x[j]+w[j] && x[j] < x[i]+w[i] && y[i] < y[j]+h[j] && y[j] < y[i]+h[i]) print "yes" }')
  [ -z "$overlap" ] && ok "no overlapping outputs" ||
    no "display outputs OVERLAP — windows will bleed between screens. Run: just desktop"
fi

# nmtui backs the impala shim (impala is an iwd-only TUI; this box excludes iwd
# for the network lock, so ~/.local/bin/impala execs nmtui instead).
have nmtui && ok "nmtui present (impala shim target)" ||
  no "nmtui missing — the impala shim has nothing to exec. Admin: sudo dnf install -y NetworkManager-tui"

# Rotation is fixed at the device layer now (hwdb ACCEL_MOUNT_MATRIX), so there
# is no daemon to check - only that the sensor service is up. Pocket 4 only.
if [ -d /sys/class/drm/card1-eDP-1 ] || [ -d /sys/class/drm/card0-eDP-1 ]; then
  systemctl is-active --quiet iio-sensor-proxy 2>/dev/null &&
    ok "iio-sensor-proxy active (rotation sensor up)" ||
    no "iio-sensor-proxy inactive — auto-rotate has no sensor. Admin: sudo systemctl enable --now iio-sensor-proxy"
  systemd-hwdb query 'sensor:modalias:acpi:MXC6655:*:dmi:*:svnGPD:pnG1628-04:*' 2>/dev/null | grep -q ACCEL_MOUNT_MATRIX &&
    ok "ACCEL_MOUNT_MATRIX resolves (orientation corrected at the device)" ||
    note "no ACCEL_MOUNT_MATRIX in hwdb — orientation may be wrong. Admin: pkexec nobara/rotation.sh"
fi

head "Summary"
printf '  %s%d passed%s   %s%d to fix%s\n' "$c_g" "$PASS" "$c_0" "$c_r" "$FAILN" "$c_0"
if [ "$FAILN" -gt 0 ]; then
  printf '\n  Fix these:\n'
  for t in "${TOFIX[@]}"; do printf '   %s✗%s %s\n' "$c_r" "$c_0" "$t"; done
  exit 1
fi
printf '  %sEverything green.%s\n' "$c_g" "$c_0"
