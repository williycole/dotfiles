#!/usr/bin/env python3
"""plasma-sync — make every machine's Plasma look and feel the same, scaling aside.

  plasma-sync save     copy THIS machine's look into the repo (then commit)
  plasma-sync apply    bring this machine to the repo's look, if the repo changed
  plasma-sync check    exit 0 if this machine matches the repo, 1 if not

WHAT SYNCS: colors + theme (kdeglobals, plasmarc), window manager behaviour,
virtual desktops, krohnkite, decorations (kwinrc), panels, widgets, pinned
launchers, wallpaper (plasma-org.kde.plasma.desktop-appletsrc), shortcuts
(kglobalshortcutsrc), mouse/cursor (kcminputrc), splash, lock screen.

WHAT STAYS PER MACHINE, on purpose:
  kwinrc [Xwayland]        the scale factor — device appropriate (1.75 on the
                           8.8" Pocket 4, 1.7 on bigplow's monitor)
  kwinrc [Tiling]...       keyed by each machine's own output + desktop UUIDs
  kwinrc [Desktops] Id_N   desktop UUIDs; the count and names DO sync
  appletsrc activityId     each machine's activity UUID; a foreign one leaves
                           the desktop containment unattached and blank
  appletsrc ItemGeometries desktop-icon positions per screen resolution
  plasmashellrc            panel thickness/geometry is per screen size — not synced

WHY apply ONLY WHEN THE REPO CHANGED. `just update` runs apply on every
machine, littleplow included. If it forced the repo look every time, a tweak
made in System Settings and not yet saved would be silently reverted by the next
update — the 2026-10-02 shape again (an install overriding a choice made on
purpose). So apply compares the repo snapshot against the one it last applied
here: unchanged repo = hands off, local tweaks survive. To share a tweak, `save`
it and commit. A forced apply backs up the local files first.
"""
import hashlib, os, re, shutil, subprocess, sys, time

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SNAP = os.path.join(REPO, "look", "plasma")  # NOT under os/linux/: dots would link it into ~/plasma
CFG = os.path.expanduser("~/.config")
STATE = os.path.expanduser("~/.local/state/plasma-sync/applied")
FILES = ["kdeglobals", "kwinrc", "plasmarc", "plasma-org.kde.plasma.desktop-appletsrc",
         "kglobalshortcutsrc", "kcminputrc", "ksplashrc", "kscreenlockerrc"]
ACT = "@LOCAL_ACTIVITY@"


def sections(text):
    """[(header, [lines])] preserving order; header '' for any preamble."""
    out, cur = [], ("", [])
    for line in text.splitlines():
        if line.startswith("["):
            out.append(cur); cur = (line, [])
        else:
            cur[1].append(line)
    out.append(cur)
    return out


def is_local_kwin(header):
    return header.startswith("[Xwayland]") or header.startswith("[Tiling]")


def strip(name, text):
    """Remove per-machine parts, so snapshots compare equal across devices."""
    if name == "kwinrc":
        keep = []
        for h, lines in sections(text):
            if is_local_kwin(h):
                continue
            if h == "[Desktops]":
                lines = [l for l in lines if not re.match(r"Id_\d+=", l)]
            keep.append((h, lines))
        return _join(keep)
    if name == "plasma-org.kde.plasma.desktop-appletsrc":
        # ItemGeometries-<W>x<H> is desktop-icon layout per screen resolution —
        # per device, like the scale. Plasma regenerates it.
        text = re.sub(r"^ItemGeometries[^=]*=.*\n?", "", text, flags=re.M)
        return re.sub(r"^activityId=[0-9a-f-]{36}$", f"activityId={ACT}", text, flags=re.M)
    return text


def _join(secs):
    parts = []
    for h, lines in secs:
        if h:
            parts.append(h)
        parts.extend(lines)
    return "\n".join(parts).rstrip("\n") + "\n"


def merge(name, repo_text, local_text):
    """Repo look + this machine's per-device parts."""
    if name == "kwinrc":
        loc = sections(local_text)
        local_only = [(h, ls) for h, ls in loc if is_local_kwin(h)]
        ids = next((ls for h, ls in loc if h == "[Desktops]"), [])
        ids = [l for l in ids if re.match(r"Id_\d+=", l)]
        out = []
        for h, ls in sections(repo_text):
            if h == "[Desktops]":
                ls = [l for l in ls if l.strip()] + ids + [""]
            out.append((h, ls))
        return _join(out + local_only)
    if name == "plasma-org.kde.plasma.desktop-appletsrc":
        m = re.search(r"^activityId=([0-9a-f-]{36})$", local_text, re.M)
        if not m:
            # No activity yet (never logged in graphically): let Plasma assign one.
            return repo_text.replace(f"activityId={ACT}", "activityId=")
        return repo_text.replace(f"activityId={ACT}", f"activityId={m.group(1)}")
    return repo_text


def read(p):
    try:
        return open(p, encoding="utf-8", errors="replace").read()
    except FileNotFoundError:
        return ""


def digest(texts):
    h = hashlib.sha256()
    for n in FILES:
        h.update(n.encode()); h.update(texts.get(n, "").encode())
    return h.hexdigest()


def repo_snapshot():
    return {n: read(os.path.join(SNAP, n)) for n in FILES if os.path.exists(os.path.join(SNAP, n))}


def local_stripped():
    return {n: strip(n, read(os.path.join(CFG, n))) for n in FILES if os.path.exists(os.path.join(CFG, n))}


def plasmashell_running():
    return subprocess.run(["pgrep", "-x", "plasmashell"], capture_output=True).returncode == 0


def cmd_save():
    os.makedirs(SNAP, exist_ok=True)
    snap = local_stripped()
    for n, t in snap.items():
        open(os.path.join(SNAP, n), "w").write(t)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    open(STATE, "w").write(digest(snap))
    print(f"  saved {len(snap)} files to {os.path.relpath(SNAP, REPO)} — commit them to share")


def cmd_check():
    repo = repo_snapshot()
    if not repo:
        print("  no snapshot in repo yet"); return 0
    same = digest(repo) == digest({n: local_stripped().get(n, "") for n in repo})
    print("  matches repo look" if same else "  differs from repo look")
    return 0 if same else 1


def cmd_apply():
    repo = repo_snapshot()
    if not repo:
        print("  no snapshot in repo — nothing to apply"); return
    want = digest(repo)
    last = read(STATE).strip()
    if want == last:
        print("  look unchanged in repo since last apply — leaving local settings alone")
        return
    local = {n: read(os.path.join(CFG, n)) for n in repo}
    if digest({n: strip(n, t) for n, t in local.items()}) == want:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        open(STATE, "w").write(want)
        print("  already matches the repo look"); return
    bak = os.path.expanduser(f"~/plasma-look-backup/pre-sync-{time.strftime('%Y%m%d-%H%M%S')}")
    os.makedirs(bak, exist_ok=True)
    for n, t in local.items():
        if t:
            open(os.path.join(bak, n), "w").write(t)
    running = plasmashell_running()
    if running:  # plasmashell rewrites appletsrc on exit; stop it before writing
        subprocess.run(["systemctl", "--user", "stop", "plasma-plasmashell"], capture_output=True)
    for n, t in repo.items():
        open(os.path.join(CFG, n), "w").write(merge(n, t, local.get(n, "")))
    if running:
        subprocess.run(["systemctl", "--user", "start", "plasma-plasmashell"], capture_output=True)
        subprocess.run(["qdbus", "org.kde.KWin", "/KWin", "reconfigure"], capture_output=True)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    open(STATE, "w").write(want)
    print(f"  applied repo look ({len(repo)} files); previous files backed up to {bak}")
    print("  log out and back in once so colors and shortcuts reload in every app")


# ---- Chromium bookmarks: same apply-only-when-the-repo-changed rule ----------
BM_LOCAL = os.path.expanduser("~/.config/chromium/Default/Bookmarks")
# The extension's overlay owns the bookmarks when it exists; this repo carries
# none. DOTS_BOOKMARKS_REPO overrides.
_BM_OVERLAY = os.path.join(os.environ.get("DOTS_EXTRA") or os.path.expanduser("~/.local/share/dots/extra"),
                           "overlay", "os", "linux", "chromium", "Bookmarks")
BM_REPO = (os.environ.get("DOTS_BOOKMARKS_REPO")
           or (_BM_OVERLAY if os.path.isdir(os.path.dirname(_BM_OVERLAY)) else None)
           or os.path.join(REPO, "os", "linux", "chromium", "Bookmarks"))
BM_STATE = os.path.expanduser("~/.local/state/plasma-sync/bookmarks-applied")


def chromium_running():
    # Anchored: an unanchored pattern matches any shell whose command line merely
    # mentions the path, which killed an ssh session on 2026-10-08.
    return subprocess.run(["pgrep", "-f", "^/usr/lib64/chromium-browser/"],
                          capture_output=True).returncode == 0


def _bm_norm(text):
    import json
    d = json.loads(text); d.pop("checksum", None); d.pop("sync_metadata", None)
    return json.dumps(d, indent=3, ensure_ascii=False) + "\n"


def cmd_bookmarks_save():
    # Reading is safe while Chromium runs: it writes Bookmarks to disk shortly
    # after every change. Only APPLY needs it closed (it would overwrite us).
    os.makedirs(os.path.dirname(BM_REPO), exist_ok=True)
    t = _bm_norm(read(BM_LOCAL))
    open(BM_REPO, "w").write(t)
    os.makedirs(os.path.dirname(BM_STATE), exist_ok=True)
    open(BM_STATE, "w").write(hashlib.sha256(t.encode()).hexdigest())
    print(f"  saved bookmarks to {BM_REPO} — commit to share")


def cmd_bookmarks_apply():
    if not os.path.exists(BM_REPO):
        print("  no bookmarks in repo — skipping"); return
    want_t = read(BM_REPO); want = hashlib.sha256(want_t.encode()).hexdigest()
    if read(BM_STATE).strip() == want:
        print("  bookmarks unchanged in repo since last apply — leaving local ones alone"); return
    if os.path.exists(BM_LOCAL) and _bm_norm(read(BM_LOCAL)) == want_t:
        os.makedirs(os.path.dirname(BM_STATE), exist_ok=True); open(BM_STATE, "w").write(want)
        print("  bookmarks already match the repo"); return
    if chromium_running():
        print("  bookmarks: repo changed but Chromium is running — quit it and rerun just update"); return
    if os.path.exists(BM_LOCAL):
        shutil.copy2(BM_LOCAL, BM_LOCAL + f".before-sync-{time.strftime('%Y%m%d-%H%M%S')}")
    os.makedirs(os.path.dirname(BM_LOCAL), exist_ok=True)
    open(BM_LOCAL, "w").write(want_t)
    os.makedirs(os.path.dirname(BM_STATE), exist_ok=True); open(BM_STATE, "w").write(want)
    print("  bookmarks applied from repo (previous file backed up)")


if __name__ == "__main__":
    c = sys.argv[1] if len(sys.argv) > 1 else ""
    if c == "save": cmd_save()
    elif c == "apply": cmd_apply()
    elif c == "check": sys.exit(cmd_check())
    elif c == "bookmarks-save": cmd_bookmarks_save()
    elif c == "bookmarks-apply": cmd_bookmarks_apply()
    else: print(__doc__.split("\n\n")[0]); sys.exit(2)
